{
    "compilerOptions": {
      "target": "ES6",
      "module": "commonjs",
      "strictPropertyInitialization": false,
      "rootDir": "./src",
      "lib": [
        "ES6",
        "ES5"
      ],
      "outDir": "./dist",
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"],
  }
  