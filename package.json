{
  "name": "bqs-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migration:generate": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js migration:generate src/postgre/migrations/migrationAuto -d src/postgre/data-source.ts",
    "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create src/postgre/migrations/migrationManual",
    "migration:run": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js migration:run -d src/postgre/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register -r dotenv/config ./node_modules/typeorm/cli.js migration:revert -d src/postgre/data-source.ts",
    "migration:run:prod": "node -r dotenv/config node_modules/typeorm/cli.js migration:run -d dist/src/postgre/data-source.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.17.12",
    "@types/supertest": "^6.0.2",
    "@types/winston": "^2.4.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "argon2": "^0.41.1",
    "babel-jest": "^29.7.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "firebase-admin": "^13.7.0",
    "http-status-codes": "^2.3.0",
    "jsonrepair": "^3.8.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.6.7",
    "pg": "^8.13.0",
    "puppeteer": "^22.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "winston": "^3.14.2"
  }
}
